# nix only drops pure evaluation for flakes on `--impure`, never from config, so every evaluating command gets it
mkdir -p .direnv/bin
cat > .direnv/bin/nix <<EOF
#!/usr/bin/env bash
case "\$1" in
  flake) exec $(command -v nix) "\$1" "\$2" --impure "\${@:3}";;
  build|run|eval|develop|shell|print-dev-env) cmd=\$1; shift; exec $(command -v nix) "\$cmd" --impure "\$@";;
esac
exec $(command -v nix) "\$@"
EOF
chmod +x .direnv/bin/nix
PATH_add .direnv/bin

