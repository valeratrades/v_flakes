# release-typst.yml: on a release tag, `nix build .#default` (the typ module's `document`) and attach its files to the
# GitHub Release as `<repo>.<ext>`; with `html`, output.html is also deployed to GitHub Pages as index.html.
{ html, lfs, cache ? { } }:
let
  nixCi = import ../../../cache.nix { inherit cache; };
in
{
  standalone = true;

  "#" = "Generated by v_flakes `github { typ = ...; }` for a typ module with `main` set.${if html then " Pages is enabled with build_type=workflow by `git_ops sync-github`." else ""}";
  name = "Release Typst";
  on = {
    push.tags = [ "v[0-9]+.*" ];
    workflow_dispatch = { };
  };
  concurrency = {
    group = "release-typst";
    cancel-in-progress = false;
  };
  permissions.contents = "write";
  jobs = {
    build = {
      runs-on = "ubuntu-latest";
      steps = [
        ({ uses = "actions/checkout@v5"; } // (if lfs then { "with".lfs = true; } else { }))
      ]
      ++ nixCi.setupSteps
      ++ [ nixCi.installStep ]
      ++ nixCi.cacheSteps
      ++ [
        {
          name = "Build";
          run = ''
            nix build .#default -o result
            mkdir dist
            for f in result/output.*; do cp "$f" "dist/''${GITHUB_REPOSITORY##*/}.''${f##*.}"; done
          '';
        }
        {
          name = "Attach to release";
          "if" = "startsWith(github.ref, 'refs/tags/')";
          env.GH_TOKEN = "\${{ github.token }}";
          run = ''
            gh release view "$GITHUB_REF_NAME" >/dev/null 2>&1 || gh release create "$GITHUB_REF_NAME" --verify-tag --generate-notes # another release workflow may have created it
            gh release upload "$GITHUB_REF_NAME" dist/* --clobber
          '';
        }
      ] ++ (if html then [
        {
          name = "Stage site";
          run = "mkdir site && cp result/output.html site/index.html";
        }
        {
          uses = "actions/upload-pages-artifact@v4";
          "with".path = "site";
        }
      ] else [ ]);
    };
  } // (if html then {
    deploy = {
      needs = "build";
      "if" = "startsWith(github.ref, 'refs/tags/')"; # the github-pages environment admits `v*` tags only
      runs-on = "ubuntu-latest";
      permissions = {
        pages = "write";
        id-token = "write";
      };
      environment = {
        name = "github-pages";
        url = "\${{ steps.deployment.outputs.page_url }}";
      };
      steps = [
        { id = "deployment"; uses = "actions/deploy-pages@v4"; }
      ];
    };
  } else { });
}
