# visual-baselines.yml: renders the committed baselines under `dir` on CI's image, uploads them as `visual-snapshots`, fails when they're stale.
# Contract in github/description.md.
{ dir, render, gate ? null, paths ? null, rustCache ? null, lfs, cachix }:
let
  app = name: "nix develop --command nix run .#${name}";
in
{
  standalone = true;

  "#" = ''
    Generated by v_flakes `github.visualBaselines`. Refresh the baselines from a run's render:

      rm -f ${dir}/**/*.png
      gh run download <run-id> -n visual-snapshots -D ${dir}
  '';
  name = "Visual baselines";
  on = {
    pull_request = if paths == null then { } else { paths = paths ++ [ ".github/workflows/visual-baselines.yml" ]; };
    workflow_dispatch = { };
  };
  permissions.contents = "read";
  jobs.render = {
    name = "render baselines";
    runs-on = "ubuntu-latest";
    steps = [
      ({ uses = "actions/checkout@v5"; } // (if lfs then { "with".lfs = true; } else { }))
      ({ uses = "./.github/actions/nix-env"; } // (
        let
          w = (if rustCache != null then { rust-cache = rustCache; } else { })
            // (if cachix then { cachix-auth-token = "\${{ secrets.CACHIX_AUTH_TOKEN }}"; } else { });
        in
        if w != { } then { "with" = w; } else { }
      ))
    ]
    ++ (if gate != null then [{
      name = "Gate";
      id = "gate";
      continue-on-error = true; # the render still uploads
      run = app gate;
    }] else [ ])
    ++ [
      {
        name = "Render";
        run = ''
          find ${dir} -name '*.png' -delete
          ${app render}
        '';
      }
      {
        name = "Upload";
        "if" = "always()";
        uses = "actions/upload-artifact@v4";
        "with" = {
          name = "visual-snapshots";
          path = "${dir}/**/*.png"; # shortcut: the artifact is rooted at the PNGs' common ancestor, so `-D ${dir}` misplaces them when all sit in one subdirectory; upgrade if a repo lays them out that way
          if-no-files-found = "error";
          retention-days = 14;
        };
      }
      (if gate != null then {
        name = "Fail on the gate";
        "if" = "steps.gate.outcome == 'failure'";
        run = ''
          echo "::error::${gate} failed: the baselines under ${dir} don't match the render; refresh them from this run's visual-snapshots"
          exit 1
        '';
      } else {
        name = "Fail on changed baselines";
        run = ''
          changed="$(git status --porcelain -- ${dir})"
          [ -z "$changed" ] && exit 0
          echo "::error::the render changed baselines under ${dir}; refresh them from this run's visual-snapshots"
          echo "$changed"
          exit 1
        '';
      })
    ];
  };
}
