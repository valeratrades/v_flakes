# figma.yml: `nix run .#figma` (`@evinvest/figma-render`'s bin) renders the repo's pages into the file named after the
# repo in a Figma folder, on a release tag and on a `[figma]` comment. Contract in github/description.md.
{ folder ? null, lfs, cache ? { } }:
let
  nixCi = import ../../../cache.nix { inherit cache; };
in
{
  standalone = true;

  "#" = ''
    Generated by v_flakes `figma` (`github` or `workflows`). Needs the secrets FIGMA_OAUTH (evinvest-figma-render's oauth.json) and
    FIGMA_TOKEN (a Figma personal access token with folders:read)${if folder == null then ", and the variable FIGMA_FOLDER (a Figma folder URL)" else ""}.
  '';
  name = "Figma";
  on = {
    push.tags = [ "v[0-9]+.*" ];
    issue_comment.types = [ "created" ];
    workflow_dispatch = { };
  };
  concurrency = {
    group = "figma";
    cancel-in-progress = false;
  };
  permissions.contents = "read";
  jobs.render = {
    name = "render into Figma";
    # a comment runs the PR's code with the Figma secrets, so only from those who can push
    "if" = "github.event_name != 'issue_comment' || (contains(github.event.comment.body, '[figma]') && contains(fromJSON('[\"OWNER\",\"MEMBER\",\"COLLABORATOR\"]'), github.event.comment.author_association))";
    runs-on = "ubuntu-latest";
    steps = [
      {
        uses = "actions/checkout@v5";
        "with" = { ref = "\${{ github.event.issue.pull_request && format('refs/pull/{0}/head', github.event.issue.number) || '' }}"; } // (if lfs then { lfs = true; } else { });
      }
    ]
    ++ nixCi.setupSteps
    ++ [ nixCi.installStep ]
    ++ nixCi.cacheSteps
    ++ [
      {
        name = "Render";
        env = {
          FIGMA_OAUTH = "\${{ secrets.FIGMA_OAUTH }}";
          FIGMA_TOKEN = "\${{ secrets.FIGMA_TOKEN }}";
          FIGMA_FOLDER = if folder == null then "\${{ vars.FIGMA_FOLDER }}" else folder;
        };
        run = ''
          for v in FIGMA_OAUTH FIGMA_TOKEN FIGMA_FOLDER; do [ -n "''${!v}" ] || { echo "::error::$v is unset"; exit 1; }; done
          state="''${XDG_STATE_HOME:-$HOME/.local/state}/evinvest-figma-render"
          mkdir -p "$state"
          printf '%s' "$FIGMA_OAUTH" > "$state/oauth.json"
          status=0 # a render with uncaptured frames still prints its link
          nix run .#figma -- --folder "$FIGMA_FOLDER" --name "''${{ github.event.repository.name }}" > "$RUNNER_TEMP/link" || status=$?
          cat "$RUNNER_TEMP/link"
          echo "Figma: $(cat "$RUNNER_TEMP/link")" >> "$GITHUB_STEP_SUMMARY"
          exit "$status"
        '';
      }
    ];
  };
}
